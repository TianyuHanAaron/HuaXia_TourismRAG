{
  "expo": {
    "name": "HuaXia Trip Command Center",
    "slug": "huaxia-trip-command-center",
    "scheme": "huaxia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f8f3ec"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-calendar",
      "expo-notifications"
    ]
  }
}
